#include <stdio.h>
#include <math.h>

int main()
{
    float num1, num2, resultado;
    char operacao;

    printf("Digite a operacao (+, -, *, /, ^): ");
    scanf(" %c", &operacao);

    printf("Digite dois numeros reais: ");
    scanf("%f %f", &num1, &num2);

    switch (operacao)
    {
        case '+':
            resultado = num1 + num2;
            printf("Resultado: %.2f\n", resultado);
            break;

        case '-':
            resultado = num1 - num2;
            printf("Resultado: %.2f\n", resultado);
            break;

        case '*':
            resultado = num1 * num2;
            printf("Resultado: %.2f\n", resultado);
            break;

        case '/':
            if (num2 != 0)
            {
                resultado = num1 / num2;
                printf("Resultado: %.2f\n", resultado);
            }
            else
            {
                printf("Erro: Divisao por zero!\n");
            }
            break;

        case '^':
            resultado = pow(num1, num2);
            printf("Resultado: %.2f\n", resultado);
            break;

        default:
            printf("Operacao invalida!\n");
    }

    return 0;
}